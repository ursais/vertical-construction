<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_catalog_crew_view_list" model="ir.ui.view">
        <field name="name">construction.catalog.crew.list</field>
        <field name="model">construction.catalog.crew</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="daily_cost"/>
                <field name="catalog_version_id"/>
            </list>
        </field>
    </record>

    <record id="construction_catalog_crew_view_form" model="ir.ui.view">
        <field name="name">construction.catalog.crew.form</field>
        <field name="model">construction.catalog.crew</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="version_state" invisible="1"/>
                    <group>
                        <field name="code" readonly="version_state == 'closed'"/>
                        <field name="name" readonly="version_state == 'closed'"/>
                        <field name="catalog_version_id" readonly="version_state == 'closed'"/>
                        <field name="daily_cost" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="active" readonly="version_state == 'closed'"/>
                    </group>
                    <notebook>
                        <page string="Members" name="members">
                            <field name="line_ids" readonly="version_state == 'closed'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="input_id"/>
                                    <field name="role"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" readonly="version_state == 'closed'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_catalog_crew" model="ir.actions.act_window">
        <field name="name">Crews</field>
        <field name="res_model">construction.catalog.crew</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
