<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_catalog_concept_category_view_list" model="ir.ui.view">
        <field name="name">construction.catalog.concept.category.list</field>
        <field name="model">construction.catalog.concept.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="construction_catalog_concept_view_list" model="ir.ui.view">
        <field name="name">construction.catalog.concept.list</field>
        <field name="model">construction.catalog.concept</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="uom_id"/>
                <field name="catalog_version_id"/>
                <field name="version_state" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="construction_catalog_concept_view_form" model="ir.ui.view">
        <field name="name">construction.catalog.concept.form</field>
        <field name="model">construction.catalog.concept</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="version_state" invisible="1"/>
                    <group>
                        <group>
                            <field name="code" readonly="version_state == 'closed'"/>
                            <field name="name" readonly="version_state == 'closed'"/>
                            <field name="category_id" readonly="version_state == 'closed'"/>
                        </group>
                        <group>
                            <field name="catalog_version_id" readonly="version_state == 'closed'"/>
                            <field name="uom_id" readonly="version_state == 'closed'"/>
                            <field name="product_id" readonly="version_state == 'closed'"/>
                            <field name="active" readonly="version_state == 'closed'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" readonly="version_state == 'closed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_catalog_concept_category" model="ir.actions.act_window">
        <field name="name">Concept Categories</field>
        <field name="res_model">construction.catalog.concept.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_construction_catalog_concept" model="ir.actions.act_window">
        <field name="name">Concepts</field>
        <field name="res_model">construction.catalog.concept</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
