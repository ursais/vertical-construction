<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_catalog_input_view_list" model="ir.ui.view">
        <field name="name">construction.catalog.input.list</field>
        <field name="model">construction.catalog.input</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="input_type"/>
                <field name="product_id"/>
                <field name="uom_id"/>
                <field name="unit_cost"/>
                <field name="catalog_version_id"/>
            </list>
        </field>
    </record>

    <record id="construction_catalog_input_view_form" model="ir.ui.view">
        <field name="name">construction.catalog.input.form</field>
        <field name="model">construction.catalog.input</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="version_state" invisible="1"/>
                    <group>
                        <group>
                            <field name="code" readonly="version_state == 'closed'"/>
                            <field name="name" readonly="version_state == 'closed'"/>
                            <field name="input_type" readonly="version_state == 'closed'"/>
                            <field name="product_id" readonly="version_state == 'closed'"/>
                        </group>
                        <group>
                            <field name="catalog_version_id" readonly="version_state == 'closed'"/>
                            <field name="uom_id" readonly="version_state == 'closed'"/>
                            <field name="unit_cost" readonly="version_state == 'closed'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="supplier_id" readonly="version_state == 'closed'"/>
                            <field name="active" readonly="version_state == 'closed'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" readonly="version_state == 'closed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_catalog_input" model="ir.actions.act_window">
        <field name="name">Inputs</field>
        <field name="res_model">construction.catalog.input</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
