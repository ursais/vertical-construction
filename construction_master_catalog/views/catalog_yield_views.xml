<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_catalog_yield_view_list" model="ir.ui.view">
        <field name="name">construction.catalog.yield.list</field>
        <field name="model">construction.catalog.yield</field>
        <field name="arch" type="xml">
            <list>
                <field name="concept_id"/>
                <field name="input_id"/>
                <field name="crew_id"/>
                <field name="yield_quantity"/>
                <field name="resource_quantity"/>
                <field name="uom_id"/>
                <field name="catalog_version_id"/>
            </list>
        </field>
    </record>

    <record id="construction_catalog_yield_view_form" model="ir.ui.view">
        <field name="name">construction.catalog.yield.form</field>
        <field name="model">construction.catalog.yield</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="version_state" invisible="1"/>
                    <group>
                        <field name="catalog_version_id" readonly="version_state == 'closed'"/>
                        <field name="concept_id" readonly="version_state == 'closed'"/>
                        <field name="input_id" readonly="version_state == 'closed'"/>
                        <field name="crew_id" readonly="version_state == 'closed'"/>
                        <field name="yield_quantity" readonly="version_state == 'closed'"/>
                        <field name="resource_quantity" readonly="version_state == 'closed'"/>
                        <field name="uom_id"/>
                        <field name="notes" readonly="version_state == 'closed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_catalog_yield" model="ir.actions.act_window">
        <field name="name">Yields</field>
        <field name="res_model">construction.catalog.yield</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
