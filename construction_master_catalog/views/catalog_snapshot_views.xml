<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_catalog_snapshot_view_list" model="ir.ui.view">
        <field name="name">construction.catalog.snapshot.list</field>
        <field name="model">construction.catalog.snapshot</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="catalog_version_id"/>
                <field name="reference"/>
                <field name="snapshot_date"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>

    <record id="construction_catalog_snapshot_view_form" model="ir.ui.view">
        <field name="name">construction.catalog.snapshot.form</field>
        <field name="model">construction.catalog.snapshot</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="catalog_version_id"/>
                        <field name="reference"/>
                        <field name="snapshot_date"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_catalog_snapshot" model="ir.actions.act_window">
        <field name="name">Catalog Snapshots</field>
        <field name="res_model">construction.catalog.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
