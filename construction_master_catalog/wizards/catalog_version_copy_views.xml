<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="construction_catalog_version_copy_view_form" model="ir.ui.view">
        <field name="name">construction.catalog.version.copy.form</field>
        <field name="model">construction.catalog.version.copy</field>
        <field name="arch" type="xml">
            <form string="Copy Catalog to New Version">
                <group>
                    <field name="source_version_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="date_start"/>
                </group>
                <footer>
                    <button name="action_copy" type="object" string="Copy" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
