<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="construction_budget_view_list" model="ir.ui.view">
        <field name="name">construction.budget.list</field>
        <field name="model">construction.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="project_id" />
                <field name="partner_id" />
                <field name="current_version_id" />
                <field name="amount_total" sum="Total" />
                <field name="amount_approved" sum="Approved" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'active'"
                    decoration-muted="state == 'closed'"
                />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="construction_budget_view_form" model="ir.ui.view">
        <field name="name">construction.budget.form</field>
        <field name="model">construction.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_activate"
                        string="Activate"
                        type="object"
                        invisible="state != 'draft'"
                        class="btn-primary"
                    />
                    <button
                        name="action_create_version"
                        string="New Version"
                        type="object"
                        invisible="state == 'closed'"
                    />
                    <button
                        name="action_compare_versions"
                        string="Compare Versions"
                        type="object"
                        invisible="version_count &lt; 2"
                    />
                    <button
                        name="action_close"
                        string="Close"
                        type="object"
                        invisible="state != 'active'"
                    />
                    <button
                        name="action_reset_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state != 'closed'"
                        groups="construction_budget_apu.group_construction_budget_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active,closed"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_versions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-code-fork"
                        >
                            <field
                                name="version_count"
                                widget="statinfo"
                                string="Versions"
                            />
                        </button>
                        <button
                            name="action_view_crossovered_budgets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="crossovered_budget_count == 0"
                        >
                            <field
                                name="crossovered_budget_count"
                                widget="statinfo"
                                string="Acct. Budgets"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="project_id" />
                            <field name="partner_id" />
                            <field name="analytic_account_id" />
                            <field name="default_budget_post_id" />
                        </group>
                        <group>
                            <field name="current_version_id" />
                            <field name="approved_version_id" />
                            <field name="crossovered_budget_count" invisible="1" />
                            <field name="sale_order_id" />
                            <field
                                name="currency_id"
                                groups="base.group_multi_currency"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="date_start" />
                            <field name="date_end" />
                        </group>
                    </group>
                    <group>
                        <field name="description" colspan="2" />
                    </group>
                    <group>
                        <field name="amount_total" />
                        <field name="amount_approved" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="construction_budget_view_search" model="ir.ui.view">
        <field name="name">construction.budget.search</field>
        <field name="model">construction.budget</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="project_id" />
                <field name="partner_id" />
                <filter
                    string="Draft"
                    name="filter_draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    string="Active"
                    name="filter_active"
                    domain="[('state', '=', 'active')]"
                />
                <filter
                    string="Closed"
                    name="filter_closed"
                    domain="[('state', '=', 'closed')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Project"
                        name="group_project"
                        context="{'group_by': 'project_id'}"
                    />
                    <filter
                        string="Status"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_budget" model="ir.actions.act_window">
        <field name="name">Construction Budgets</field>
        <field name="res_model">construction.budget</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="construction_budget_view_search" />
    </record>
</odoo>
