<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="construction_budget_version_view_list" model="ir.ui.view">
        <field name="name">construction.budget.version.list</field>
        <field name="model">construction.budget.version</field>
        <field name="arch" type="xml">
            <list decoration-muted="is_frozen">
                <field name="budget_id" />
                <field name="version_number" />
                <field name="name" />
                <field name="amount_total" sum="Total" />
                <field name="crossovered_budget_state" string="Acct. Budget" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'submitted'"
                    decoration-success="state in ('approved', 'frozen')"
                    decoration-danger="state == 'rejected'"
                />
                <field name="is_frozen" column_invisible="True" />
                <field name="date_approved" />
                <field name="date_frozen" />
            </list>
        </field>
    </record>

    <record id="construction_budget_version_view_form" model="ir.ui.view">
        <field name="name">construction.budget.version.form</field>
        <field name="model">construction.budget.version</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_submit"
                        string="Submit"
                        type="object"
                        invisible="state != 'draft'"
                        class="btn-primary"
                    />
                    <button
                        name="action_open_approve_wizard"
                        string="Approve"
                        type="object"
                        invisible="state not in ('draft', 'submitted')"
                        groups="construction_budget_apu.group_construction_budget_manager"
                    />
                    <button
                        name="action_freeze"
                        string="Freeze"
                        type="object"
                        invisible="state != 'approved'"
                        groups="construction_budget_apu.group_construction_budget_manager"
                    />
                    <button
                        name="action_reject"
                        string="Reject"
                        type="object"
                        invisible="state not in ('draft', 'submitted')"
                        groups="construction_budget_apu.group_construction_budget_manager"
                    />
                    <button
                        name="action_reset_draft"
                        string="Reset to Draft"
                        type="object"
                        invisible="state not in ('submitted', 'rejected')"
                        groups="construction_budget_apu.group_construction_budget_manager"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,submitted,approved,frozen"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Frozen"
                        bg_color="text-bg-secondary"
                        invisible="not is_frozen"
                    />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_crossovered_budget"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="not crossovered_budget_id"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">Accounting Budget</span>
                                <field
                                    name="crossovered_budget_state"
                                    class="o_stat_value"
                                />
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="budget_id" readonly="1" />
                            <field name="version_number" readonly="1" />
                            <field name="parent_version_id" readonly="1" />
                            <field name="project_id" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="amount_total" />
                            <field name="amount_material" />
                            <field name="amount_labor" />
                            <field name="amount_equipment" />
                            <field name="amount_subcontract" />
                            <field name="amount_other" />
                            <field name="crossovered_budget_id" readonly="1" />
                            <field name="is_frozen" invisible="1" />
                            <field name="date_submitted" readonly="1" />
                            <field name="date_approved" readonly="1" />
                            <field name="date_frozen" readonly="1" />
                            <field name="approved_by_id" readonly="1" />
                            <field name="frozen_by_id" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Chapters" name="chapters">
                            <field name="chapter_ids" readonly="is_frozen">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="budget_post_id" />
                                    <field
                                        name="parent_id"
                                        domain="[('version_id', '=', parent.version_id), ('id', '!=', id)]"
                                    />
                                    <field name="line_count" />
                                    <field name="amount_total" sum="Total" />
                                </list>
                            </field>
                        </page>
                        <page string="Line Items" name="lines">
                            <field name="line_ids" readonly="is_frozen">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="chapter_id" />
                                    <field name="code" />
                                    <field name="name" />
                                    <field name="quantity" />
                                    <field name="uom_id" />
                                    <field name="apu_mode" />
                                    <field name="unit_price" />
                                    <field name="subtotal" sum="Total" />
                                    <button
                                        name="action_open_apu"
                                        type="object"
                                        string="APU"
                                        icon="fa-calculator"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" readonly="is_frozen" />
                            <field
                                name="rejection_reason"
                                readonly="1"
                                invisible="state != 'rejected'"
                            />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_construction_budget_version" model="ir.actions.act_window">
        <field name="name">Budget Versions</field>
        <field name="res_model">construction.budget.version</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
