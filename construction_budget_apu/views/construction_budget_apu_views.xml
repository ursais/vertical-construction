<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="construction_budget_apu_view_list" model="ir.ui.view">
        <field name="name">construction.budget.apu.list</field>
        <field name="model">construction.budget.apu</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="reference" />
                <field name="unit_price" />
                <field name="amount_material" />
                <field name="amount_labor" />
                <field name="amount_equipment" />
            </list>
        </field>
    </record>

    <record id="construction_budget_apu_view_form" model="ir.ui.view">
        <field name="name">construction.budget.apu.form</field>
        <field name="model">construction.budget.apu</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="reference" />
                        <field name="unit_price" readonly="1" />
                        <field name="amount_material" readonly="1" />
                        <field name="amount_labor" readonly="1" />
                        <field name="amount_equipment" readonly="1" />
                        <field name="amount_subcontract" readonly="1" />
                        <field name="amount_other" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Components" name="components">
                            <field name="component_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="component_type" />
                                    <field name="product_id" />
                                    <field name="name" />
                                    <field name="quantity" />
                                    <field name="uom_id" />
                                    <field name="waste_percent" />
                                    <field name="effective_quantity" />
                                    <field name="unit_cost" />
                                    <field name="subtotal" sum="Total" />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
