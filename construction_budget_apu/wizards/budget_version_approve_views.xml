<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="construction_budget_version_approve_view_form" model="ir.ui.view">
        <field name="name">construction.budget.version.approve.form</field>
        <field name="model">construction.budget.version.approve</field>
        <field name="arch" type="xml">
            <form string="Approve Budget Version">
                <group>
                    <field name="version_id" />
                    <field name="budget_id" />
                    <field name="freeze_on_approve" />
                    <field name="notes" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm Approval"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="construction_budget_version_reject_view_form" model="ir.ui.view">
        <field name="name">construction.budget.version.reject.form</field>
        <field name="model">construction.budget.version.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Budget Version">
                <group>
                    <field name="version_id" />
                    <field name="rejection_reason" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        string="Reject"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
