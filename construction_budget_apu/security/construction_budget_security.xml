<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_construction_budget_user" model="res.groups">
        <field name="name">Construction Budget User</field>
        <field name="category_id" ref="base.module_category_services_project" />
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]" />
    </record>

    <record id="group_construction_budget_manager" model="res.groups">
        <field name="name">Construction Budget Manager</field>
        <field name="category_id" ref="base.module_category_services_project" />
        <field name="implied_ids" eval="[(4, ref('group_construction_budget_user'))]" />
        <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="construction_budget_comp_rule" model="ir.rule">
        <field name="name">Construction Budget multi-company</field>
        <field name="model_id" ref="model_construction_budget" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="construction_budget_version_comp_rule" model="ir.rule">
        <field name="name">Construction Budget Version multi-company</field>
        <field name="model_id" ref="model_construction_budget_version" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
